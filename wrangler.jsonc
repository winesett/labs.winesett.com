{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labs-winesett-com",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "labs.winesett.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
